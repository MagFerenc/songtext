[length:02:53.81]
[tempo:175]
[by:MIDI → LRC]
[00:00.99]<00:00.99>KACSATÁNC
[00:07.81]<00:07.81>ITT A LEGÚJABB DIVAT, MI A
[00:10.16]<00:10.16>DISZKÓRA KIHAT,
[00:11.16]<00:11.16>MIRE A TINI VÍGAD,
[00:12.47]<00:12.47>POLKÁZZUNK MÁR!
[00:13.66]<00:13.66>MA AZ Ó DIVAT A SIKK, EZ A
[00:15.40]<00:15.40>ZENE JÓLESIK,
[00:16.46]<00:16.46>GYERE CSÖRÖGNI KICSIT, JÓ
[00:18.14]<00:18.14>DISZKÓ VÁR!
[00:19.31]<00:19.31>MA A POLKA A TIED, HOLNAP
[00:20.75]<00:20.75>VÁR A MENÜETT,
[00:22.20]<00:22.20>TARANTELLA, S A MAZURKA
[00:23.24]<00:23.24>LESZ NAGY SZTÁR,
[00:24.54]<00:24.54>AKI MA IDE BENÉZ, ARRA VÁR
[00:26.63]<00:26.63>A POLONÉZ,
[00:27.47]<00:27.47>S LEHET, HOGY JÖVÖRE
[00:28.33]<00:28.33>WIENER WALZERT JÁR!
[00:30.05]<00:30.05>RFR. DISZKÓBA NÉHA
[00:32.77]<00:32.77>HÉBE-HÓBA AMANDA LEAR
[00:37.83]<00:37.83>HIÁBA BÚG,
[00:40.73]<00:40.73>A PESTI SRÁC ÍGY SZÓL A
[00:44.83]<00:44.83>LÁNYHOZ:
[00:46.46]<00:46.46>"E CIKI NÓTA MÁR ELAVULT!"
[00:51.90]<00:51.90>MA A LISTAVEZETÖ, EZ A
[00:53.82]<00:53.82>DIVAT, A MENÖ,
[00:54.71]<00:54.71>MA A CINTULA IS EZT
[00:55.97]<00:55.97>FORGATJA CSAK!
[00:57.56]<00:57.56>ERRE ZAKATOL A BÁL, MIT A
[00:59.40]<00:59.40>CIGÁNY BAZSEVÁL,
[01:00.25]<01:00.25>CSAKIS ERRE A ZENÉRE UGRIK
[01:01.61]<01:01.61>JATT!
[01:02.91]<01:02.91>ERRE SZÓRAKOZIK PEST ÉS A
[01:04.77]<01:04.77>TANYASI SE REST,
[01:05.99]<01:05.99>MARI NÉNI MEG AZ APJUK EZT
[01:07.52]<01:07.52>JÁRJA, ERRE DALOL A MADÁR
[01:09.64]<01:09.64>ÉS A GÓLYA ERRE SZÁLL:
[01:11.22]<01:11.22>ILYEN SZEXI DAL UTÁN
[01:13.59]<01:13.59>LESZ SOK DOLGA!
