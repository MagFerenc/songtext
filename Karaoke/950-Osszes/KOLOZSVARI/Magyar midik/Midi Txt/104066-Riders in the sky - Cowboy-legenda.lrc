[00:24.69]<00:24.69>MÁR SRÁCKOROMBAN A
[00:26.26]<00:26.26>VADNYUGATRÓL ÁLMODOZTAM
[00:27.96]<00:27.96>ÉN,
[00:29.45]<00:29.45>ÉS KÉPZELETBEN OTT
[00:32.41]<00:32.41>JÁRTAM A PRÉRIK REJTEKÉN,
[00:35.31]<00:35.31>A NYÁJAM MELLETT ÉRT ENGEM
[00:38.72]<00:38.72>A HAJNALHASADÁS.
[00:40.52]<00:40.52>S A LEGSZEBB ZENE VOLT
[00:42.68]<00:42.68>NEKEM AZ OSTORPATTOGÁS.
[00:47.96]<00:47.96>YI-PI-Á-JÉ! YI-PI-Á-JÓ!
[00:48.15]<00:48.15>EGY COWBOYNAK, Ó, DE JÓ!
[00:49.02]<00:49.02>Ó, ENGEM SOSEM CSÁBÍTOTT A
[00:50.65]<00:50.65>MESSZI VADNYUGAT,
[00:54.70]<00:54.70>HOL MARHÁK MELLETT
[00:56.00]<00:56.00>ALSZANAK A BUTA FÉRFIAK,
[00:59.89]<00:59.89>ÉN, SZERETEM A VERSEKET,
[01:02.52]<01:02.52>AZ ÁLMATAG ZENÉT,
[01:04.90]<01:04.90>S A FIÚT, AKI RAJTAM
[01:06.88]<01:06.88>FELEDTE SZEMÉT.
[01:13.36]<01:13.36>YI-PI-Á-JÉ! YI-PI-Á-JÓ!
[01:22.02]<01:22.02>EGY COWBOYNAK, Ó, DE JÓ!
[01:33.19]<01:33.19>HA AGYAMRA MENT MÁR A
[01:39.41]<01:39.41>PRÉRI ÉS A BÚS MAGÁNY,
[01:42.57]<01:42.57>EGY KOCSMA MÉLYÉN
[01:44.30]<01:44.30>KÁRTYÁZTAM, MINT HÍRES
[01:45.56]<01:45.56>NAGY VAGÁNY,
[01:48.21]<01:48.21>ÉS TUDTA RÓLAM VÁROSSZERE
[01:50.70]<01:50.70>MINDEN KICSI NŐ,
[01:52.45]<01:52.45>HOGY ÉN VAGYOK A FÜRGE
[01:55.20]<01:55.20>JOE, A BIZTOS CÉLLÖVŐ.
[02:16.58]<02:16.58>YI-PI-Á-JÉ! YI-PI-Á-JÓ!
[02:24.52]<02:24.52>EGY COWBOYNAK, Ó, DE JÓ!
[02:24.66]<02:24.66>AZ ÜGYESSÉGET NEM CSUPÁN A
[02:25.16]<02:25.16>PRÉRIN TANULJÁK,
[02:25.66]<02:25.66>HA RAJTAM AKARSZ TÚLTENNI,
[02:26.16]<02:26.16>HÁT HÚZD FEL A CSIZMÁD,
[02:26.66]<02:26.66>ÉN BEVALLOM, HOGY FÉLEK,
[02:27.16]<02:27.16>HOGYHA LÁTOK EGY LOVAT,
[02:27.66]<02:27.66>DE LASSZÓ NÉLKÜL ÉPPENÚGY
[02:28.16]<02:28.16>FOGVATARTALAK.
[02:28.66]<02:28.66>YI-PI-Á-JÉ! YI-PI-Á-JÓ!
[02:29.16]<02:29.16>EGY COWBOYNAK, Ó, DE JÓ!
[02:29.66]<02:29.66>A KÉT KEZEMBEN KÉT
[02:30.16]<02:30.16>PISZTOLLYAL ÉN VOTAM A
[02:30.66]<02:30.66>HŐS!
[02:31.16]<02:31.16>DE MEGNŐSÜLTÉL KEDVESEM,
[02:31.66]<02:31.66>MOST ITTHON LÉGY ERŐS.
[02:32.16]<02:32.16>A VADNYUGATI KORSZAK
[02:32.66]<02:32.66>CSUPÁN ÁLMODOZÁS VOLT,
[02:33.16]<02:33.16>DE ÁLMAINKBAN NÉHA MÉG
[02:33.66]<02:33.66>ELDÖRREN A COLT.
[02:34.16]<02:34.16>YI-PI-Á-JÉ! YI-PI-Á-JÓ!
[02:34.66]<02:34.66>EGY COWBOYNAK, Ó, DE JÓ!
